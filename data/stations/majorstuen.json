    {
      "id": "curated:vigelandsanlegget",
      "name": {
        "nb": "Vigelandsanlegget",
        "en": "Vigeland Sculpture Park"
      },
      "category": "attraction",
      "lat": 59.926903,
      "lon": 10.701208,
      "score": 23,
